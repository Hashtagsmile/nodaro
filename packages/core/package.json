{
  "name": "nodaro",
  "version": "0.1.0",
  "description": "Zero-config MongoDB admin panel — embed or run standalone",
  "keywords": [
    "mongodb",
    "admin",
    "dashboard",
    "developer-tools"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "public",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hashtagsmile/nodaro.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Hashtagsmile/nodaro/issues"
  },
  "homepage": "https://github.com/Hashtagsmile/nodaro#readme",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "node ./scripts/prepublish-check.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "mongoose": "^8.18.1",
    "pino": "^9.7.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "@types/supertest": "^6.0.2",
    "mongodb-memory-server": "^10.1.4",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.0.5"
  }
}
